# Скопируйте файл в .env и заполните ОДИН из вариантов.
# .env добавлен в .gitignore — токен не попадёт в репозиторий.

# Вариант 1 (проще): API-токен из настроек аккаунта.
# https://sketchfab.com/settings/password -> раздел "API token"
SKETCHFAB_API_TOKEN=

# Вариант 2: OAuth2 access token, передаётся заголовком Authorization: Bearer ...
SKETCHFAB_OAUTH_TOKEN=

# Необязательно: свой токен и схема.
# SKETCHFAB_TOKEN=
# SKETCHFAB_TOKEN_SCHEME=Token
